{
  "name": "@git4vsc/ui",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external react --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@git4vsc/git-graph": "workspace:*",
    "@git4vsc/shared-types": "workspace:*",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17"
  }
}

