{
  "name": "git4vsc",
  "displayName": "Git4VSC",
  "description": "%extension.description%",
  "version": "0.1.8",
  "publisher": "Listen",
  "license": "MIT",
  "pricing": "Free",
  "categories": ["SCM Providers", "Visualization"],
  "keywords": [
    "git",
    "scm",
    "source control",
    "commit",
    "commit log",
    "git graph",
    "branch",
    "merge",
    "conflict resolution",
    "rebase",
    "cherry pick",
    "push preview",
    "force push",
    "pull",
    "diff",
    "git blame",
    "ai commit message"
  ],
  "icon": "media/git4vsc-marketplace.png",
  "galleryBanner": { "color": "#202938", "theme": "dark" },
  "repository": {
    "type": "git",
    "url": "https://github.com/Listen3/git4vsc.git"
  },
  "homepage": "https://github.com/Listen3/git4vsc",
  "bugs": { "url": "https://github.com/Listen3/git4vsc/issues" },
  "qna": "https://github.com/Listen3/git4vsc/issues",
  "type": "module",
  "engines": { "vscode": "^1.102.0" },
  "main": "./dist/extension.cjs",
  "activationEvents": ["onStartupFinished"],
  "scripts": {
    "build": "pnpm build:webview && pnpm build:extension",
    "build:webview": "vite build --config vite.config.ts",
    "build:extension": "tsup --config tsup.config.ts",
    "prepackage:vsix": "pnpm --filter \"@git4vsc/*\" build",
    "package:vsix": "node -e \"require('node:fs').mkdirSync('../../artifacts',{recursive:true})\" && pnpm build && vsce package --no-dependencies --out ../../artifacts/git4vsc-0.1.8.vsix",
    "typecheck": "tsc --noEmit",
    "test:extension": "node ./test/runTest.cjs"
  },
  "dependencies": {
    "@git4vsc/git-core": "workspace:*",
    "@git4vsc/repo-state": "workspace:*",
    "@git4vsc/shared-types": "workspace:*",
    "@git4vsc/ui": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "1.102.0",
    "@vscode/vsce": "^3.9.2",
    "@vscode/test-electron": "^3.1.0",
    "mocha": "^11.7.5"
  },
  "contributes": {
    "commands": [
      { "command": "git4vsc.refresh", "title": "Refresh", "category": "Git4VSC", "icon": "$(refresh)" },
      { "command": "git4vsc.showFileHistory", "title": "File History", "category": "Git4VSC" },
      { "command": "git4vsc.toggleBlameAnnotations", "title": "Annotate with Git Blame", "category": "Git4VSC" },
      { "command": "git4vsc.showBlameCommit", "title": "Show Blame Commit in Log", "category": "Git4VSC" },
      { "command": "git4vsc.openWorktrees", "title": "Manage Worktrees", "category": "Git4VSC", "icon": "$(multiple-windows)" },
      { "command": "git4vsc.refreshWorktrees", "title": "Refresh Worktrees", "category": "Git4VSC", "icon": "$(refresh)" },
      { "command": "git4vsc.newWorktree", "title": "New Worktree", "category": "Git4VSC", "icon": "$(add)" },
      { "command": "git4vsc.openWorktree", "title": "Open Worktree", "category": "Git4VSC", "icon": "$(folder-opened)" },
      { "command": "git4vsc.deleteWorktree", "title": "Delete Worktree", "category": "Git4VSC", "icon": "$(trash)" },
      { "command": "git4vsc.pruneWorktrees", "title": "Prune Missing Worktrees", "category": "Git4VSC", "icon": "$(clear-all)" },
      { "command": "git4vsc.lockWorktree", "title": "Lock Worktree", "category": "Git4VSC", "icon": "$(lock)" },
      { "command": "git4vsc.unlockWorktree", "title": "Unlock Worktree", "category": "Git4VSC", "icon": "$(unlock)" },
      { "command": "git4vsc.copyWorktreePath", "title": "Copy Worktree Path", "category": "Git4VSC", "icon": "$(copy)" },
      { "command": "git4vsc.stage", "title": "Stage Changes", "category": "Git4VSC", "icon": "$(add)" },
      { "command": "git4vsc.unstage", "title": "Unstage Changes", "category": "Git4VSC", "icon": "$(remove)" },
      { "command": "git4vsc.commit", "title": "Commit Staged Changes", "category": "Git4VSC", "icon": "$(check)" },
      { "command": "git4vsc.commitAll", "title": "Commit All Changes", "category": "Git4VSC" },
      { "command": "git4vsc.stashChanges", "title": "Stash Changes", "category": "Git4VSC", "icon": "$(archive)" },
      { "command": "git4vsc.manageStashes", "title": "Manage Stashes", "category": "Git4VSC", "icon": "$(list-tree)" },
      { "command": "git4vsc.openCommitView", "title": "Open Commit Tool Window", "category": "Git4VSC", "icon": "$(checklist)" },
      { "command": "git4vsc.showBranchMenu", "title": "Repository and Branch Actions", "category": "Git4VSC", "icon": "$(ellipsis)" },
      { "command": "git4vsc.updateCurrentBranch", "title": "Update Current Branch", "category": "Git4VSC", "icon": { "light": "media/update-light.svg", "dark": "media/update-dark.svg" } },
      { "command": "git4vsc.updateCurrentBranchAvailable", "title": "Update Current Branch", "category": "Git4VSC", "icon": { "light": "media/update-active-light.svg", "dark": "media/update-active-dark.svg" } },
      { "command": "git4vsc.pushCurrentBranch", "title": "Push Current Branch", "category": "Git4VSC", "icon": { "light": "media/push-light.svg", "dark": "media/push-dark.svg" } },
      { "command": "git4vsc.pushCurrentBranchAvailable", "title": "Push Current Branch", "category": "Git4VSC", "icon": { "light": "media/push-active-light.svg", "dark": "media/push-active-dark.svg" } },
      { "command": "git4vsc.openLog", "title": "Open Commit Log", "category": "Git4VSC", "icon": "$(git-commit)" },
      { "command": "git4vsc.openSettings", "title": "Open Settings", "category": "Git4VSC", "icon": "$(settings-gear)" },
      { "command": "git4vsc.toggleLog", "title": "Toggle Commit Log", "category": "Git4VSC", "icon": "$(git-commit)" },
      { "command": "git4vsc.justifyPanel", "title": "Stretch Panel to Full Width", "category": "Git4VSC", "icon": "$(layout-panel)" },
      { "command": "git4vsc.resolveConflicts", "title": "Resolve Conflicts", "category": "Git4VSC", "icon": "$(merge)" },
      { "command": "git4vsc.openConflict", "title": "Open Merge Editor", "category": "Git4VSC", "icon": "$(diff)" },
      { "command": "git4vsc.markConflictResolved", "title": "Mark Resolved and Open Next", "category": "Git4VSC", "icon": "$(pass)" },
      { "command": "git4vsc.acceptCurrent", "title": "Accept Current", "category": "Git4VSC" },
      { "command": "git4vsc.acceptIncoming", "title": "Accept Incoming", "category": "Git4VSC" },
      { "command": "git4vsc.restartConflict", "title": "Restart Merge for File", "category": "Git4VSC" },
      { "command": "git4vsc.continueOperation", "title": "Continue Git Operation", "category": "Git4VSC", "icon": "$(debug-continue)" },
      { "command": "git4vsc.abortOperation", "title": "Abort Git Operation", "category": "Git4VSC", "icon": "$(debug-stop)" },
      { "command": "git4vsc.operationStatus", "title": "Git operation in progress", "category": "Git4VSC", "icon": "$(sync~spin)" }
    ],
    "configuration": {
      "title": "Git4VSC",
      "type": "object",
      "properties": {
        "git4vsc.updateStrategy": {
          "type": "string",
          "enum": ["ask", "merge", "rebase"],
          "enumDescriptions": ["Ask before each update.", "Merge incoming commits.", "Rebase the current branch onto incoming commits."],
          "default": "ask",
          "scope": "window",
          "order": 10,
          "description": "Controls how incoming commits are integrated when updating the current branch."
        },
        "git4vsc.protectedBranches": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["main", "master", "release/*"],
          "scope": "window",
          "order": 11,
          "description": "Branch name patterns on which Force Push is disabled. Use * as a wildcard."
        },
        "git4vsc.confirmForcePush": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "order": 12,
          "description": "Requires confirmation before Force Push with lease."
        },
        "git4vsc.autoUpdateOnPushRejected": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "order": 13,
          "description": "Updates using the configured strategy and retries when a push is rejected as non-fast-forward."
        },
        "git4vsc.smartOperations": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "order": 14,
          "description": "Offers to stash and restore local changes when they block update or checkout."
        },
        "git4vsc.showResultNotifications": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "order": 20,
          "description": "Shows short result notifications after successful Git operations."
        },
        "git4vsc.showOperationProgress": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "order": 30,
          "description": "Shows progress indicators inside Git4VSC views during longer operations."
        },
        "git4vsc.ai.baseUrl": {
          "type": "string",
          "default": "",
          "scope": "window",
          "order": 100,
          "description": "Base URL of an OpenAI-compatible API."
        },
        "git4vsc.ai.model": {
          "type": "string",
          "default": "",
          "scope": "window",
          "order": 110,
          "description": "Model used to generate commit messages."
        },
        "git4vsc.ai.language": {
          "type": "string",
          "enum": ["system", "zh", "en"],
          "enumDescriptions": ["Follow the VS Code display language.", "Generate messages in Chinese.", "Generate messages in English."],
          "default": "system",
          "scope": "window",
          "order": 120,
          "description": "Preferred language for generated commit messages."
        },
        "git4vsc.ai.commitPrompt": {
          "type": "string",
          "default": "",
          "scope": "window",
          "order": 130,
          "description": "Additional instructions for generated commit messages."
        }
      }
    },
    "keybindings": [
      {
        "command": "git4vsc.toggleLog",
        "key": "alt+3",
        "when": "workspaceFolderCount > 0"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "git4vsc", "title": "Git4VSC", "icon": "media/git4vsc.svg" }
      ],
      "panel": [
        { "id": "git4vscLogPanel", "title": "Git Log", "icon": "media/git4vsc.svg" },
        { "id": "git4vscMergePanel", "title": "Git Merge", "icon": "media/git4vsc.svg" }
      ]
    },
    "views": {
      "git4vsc": [
        { "type": "webview", "id": "git4vsc.repositories", "name": "Commit" },
        { "id": "git4vsc.worktrees", "name": "Worktrees", "when": "git4vsc.hasLinkedWorktrees", "visibility": "visible" }
      ],
      "git4vscLogPanel": [
        { "type": "webview", "id": "git4vsc.logView", "name": "Log" }
      ],
      "git4vscMergePanel": [
        { "id": "git4vsc.conflicts", "name": "Merge Conflicts", "when": "git4vsc.hasConflicts" }
      ]
    },
    "menus": {
      "editor/lineNumber/context": [
        { "command": "git4vsc.showFileHistory", "when": "resourceScheme == file", "group": "navigation@-101" },
        { "command": "git4vsc.toggleBlameAnnotations", "when": "resourceScheme == file", "group": "navigation@-100", "toggled": "git4vsc.blameVisible" }
      ],
      "editor/context": [
        { "command": "git4vsc.showFileHistory", "when": "resourceScheme == file", "group": "git4vsc@1" },
        { "command": "git4vsc.toggleBlameAnnotations", "when": "resourceScheme == file", "group": "git4vsc@2", "toggled": "git4vsc.blameVisible" }
      ],
      "scm/title": [
        { "command": "git4vsc.showBranchMenu", "when": "scmProvider == git4vsc", "group": "navigation@5" },
        { "command": "git4vsc.openLog", "when": "scmProvider == git4vsc", "group": "navigation@10" },
        { "command": "git4vsc.resolveConflicts", "when": "scmProvider == git4vsc && git4vsc.hasConflicts", "group": "navigation@20" },
        { "command": "git4vsc.continueOperation", "when": "scmProvider == git4vsc && git4vsc.operationInProgress && !git4vsc.hasConflicts", "group": "navigation@30" },
        { "command": "git4vsc.abortOperation", "when": "scmProvider == git4vsc && git4vsc.operationInProgress", "group": "navigation@40" },
        { "command": "git4vsc.refresh", "when": "scmProvider == git4vsc", "group": "navigation@50" }
      ],
      "scm/resourceState/context": [
        { "command": "git4vsc.openConflict", "when": "scmProvider == git4vsc && scmResourceGroup == merge", "group": "inline@1" },
        { "command": "git4vsc.markConflictResolved", "when": "scmProvider == git4vsc && scmResourceGroup == merge", "group": "inline@2" },
        { "command": "git4vsc.acceptCurrent", "when": "scmProvider == git4vsc && scmResourceGroup == merge", "group": "conflict@10" },
        { "command": "git4vsc.acceptIncoming", "when": "scmProvider == git4vsc && scmResourceGroup == merge", "group": "conflict@20" },
        { "command": "git4vsc.restartConflict", "when": "scmProvider == git4vsc && scmResourceGroup == merge", "group": "conflict@30" },
        { "command": "git4vsc.stage", "when": "scmProvider == git4vsc && (scmResourceGroup == working || scmResourceGroup == untracked)", "group": "inline@1" },
        { "command": "git4vsc.unstage", "when": "scmProvider == git4vsc && scmResourceGroup == staged", "group": "inline@1" }
      ],
      "view/title": [
        { "command": "git4vsc.refresh", "when": "view == git4vsc.repositories && !git4vsc.busy", "group": "navigation@1" },
        { "command": "git4vsc.operationStatus", "when": "view == git4vsc.repositories && git4vsc.busy", "group": "navigation@1" },
        { "command": "git4vsc.updateCurrentBranch", "when": "view == git4vsc.repositories && !git4vsc.busy && !git4vsc.hasIncoming", "group": "navigation@2" },
        { "command": "git4vsc.updateCurrentBranchAvailable", "when": "view == git4vsc.repositories && !git4vsc.busy && git4vsc.hasIncoming", "group": "navigation@2" },
        { "command": "git4vsc.pushCurrentBranch", "when": "view == git4vsc.repositories && !git4vsc.busy && !git4vsc.hasOutgoing", "group": "navigation@3" },
        { "command": "git4vsc.pushCurrentBranchAvailable", "when": "view == git4vsc.repositories && !git4vsc.busy && git4vsc.hasOutgoing", "group": "navigation@3" },
        { "command": "git4vsc.toggleLog", "when": "view == git4vsc.repositories", "group": "navigation@4" },
        { "command": "git4vsc.openSettings", "when": "view == git4vsc.repositories", "group": "navigation@99" },
        { "command": "git4vsc.showBranchMenu", "when": "view == git4vsc.repositories", "group": "navigation@100" },
        { "command": "git4vsc.justifyPanel", "when": "view == git4vsc.logView && !git4vsc.busy", "group": "navigation@1" },
        { "command": "git4vsc.operationStatus", "when": "view == git4vsc.logView && git4vsc.busy", "group": "navigation@1" },
        { "command": "git4vsc.openSettings", "when": "view == git4vsc.logView", "group": "navigation@99" },
        { "command": "git4vsc.resolveConflicts", "when": "view == git4vsc.conflicts", "group": "navigation@1" },
        { "command": "git4vsc.abortOperation", "when": "view == git4vsc.conflicts", "group": "navigation@2" },
        { "command": "git4vsc.newWorktree", "when": "view == git4vsc.worktrees", "group": "navigation@1" },
        { "command": "git4vsc.refreshWorktrees", "when": "view == git4vsc.worktrees", "group": "navigation@2" },
        { "command": "git4vsc.pruneWorktrees", "when": "view == git4vsc.worktrees", "group": "navigation@3" }
      ],
      "commandPalette": [
        { "command": "git4vsc.updateCurrentBranchAvailable", "when": "false" },
        { "command": "git4vsc.pushCurrentBranchAvailable", "when": "false" },
        { "command": "git4vsc.openWorktree", "when": "false" },
        { "command": "git4vsc.deleteWorktree", "when": "false" },
        { "command": "git4vsc.lockWorktree", "when": "false" },
        { "command": "git4vsc.unlockWorktree", "when": "false" },
        { "command": "git4vsc.copyWorktreePath", "when": "false" }
      ],
      "view/item/context": [
        { "command": "git4vsc.openConflict", "when": "view == git4vsc.conflicts && viewItem == git4vsc.conflict", "group": "inline@1" },
        { "command": "git4vsc.markConflictResolved", "when": "view == git4vsc.conflicts && viewItem == git4vsc.conflict", "group": "inline@2" },
        { "command": "git4vsc.acceptCurrent", "when": "view == git4vsc.conflicts && viewItem == git4vsc.conflict", "group": "conflict@10" },
        { "command": "git4vsc.acceptIncoming", "when": "view == git4vsc.conflicts && viewItem == git4vsc.conflict", "group": "conflict@20" },
        { "command": "git4vsc.restartConflict", "when": "view == git4vsc.conflicts && viewItem == git4vsc.conflict", "group": "conflict@30" },
        { "command": "git4vsc.openWorktree", "when": "view == git4vsc.worktrees && viewItem =~ /git4vsc\\.worktree\\.(main|linked|locked)/", "group": "inline@1" },
        { "command": "git4vsc.openWorktree", "when": "view == git4vsc.worktrees && viewItem =~ /git4vsc\\.worktree\\.(main|linked|locked)/", "group": "navigation@1" },
        { "command": "git4vsc.copyWorktreePath", "when": "view == git4vsc.worktrees", "group": "navigation@2" },
        { "command": "git4vsc.lockWorktree", "when": "view == git4vsc.worktrees && viewItem == git4vsc.worktree.linked", "group": "manage@1" },
        { "command": "git4vsc.unlockWorktree", "when": "view == git4vsc.worktrees && viewItem == git4vsc.worktree.locked", "group": "manage@1" },
        { "command": "git4vsc.deleteWorktree", "when": "view == git4vsc.worktrees && viewItem == git4vsc.worktree.linked", "group": "manage@2" }
      ]
    },
    "colors": [
      {
        "id": "git4vsc.blame.foreground",
        "description": "Git blame annotation foreground.",
        "defaults": { "dark": "#D2D4D6", "light": "#505357", "highContrast": "#FFFFFF", "highContrastLight": "#000000" }
      },
      {
        "id": "git4vsc.blame.newestBackground",
        "description": "Git blame annotation background for the newest changes.",
        "defaults": { "dark": "#415548", "light": "#DCE9DF", "highContrast": "#31523B", "highContrastLight": "#D5EAD9" }
      },
      {
        "id": "git4vsc.blame.newerBackground",
        "description": "Git blame annotation background for newer changes.",
        "defaults": { "dark": "#43525A", "light": "#DCE6EB", "highContrast": "#304E5C", "highContrastLight": "#D4E7EF" }
      },
      {
        "id": "git4vsc.blame.middleBackground",
        "description": "Git blame annotation background for changes in the middle of the file history.",
        "defaults": { "dark": "#4E4B58", "light": "#E5E0EA", "highContrast": "#4A405A", "highContrastLight": "#E7DDEF" }
      },
      {
        "id": "git4vsc.blame.olderBackground",
        "description": "Git blame annotation background for older changes.",
        "defaults": { "dark": "#55494B", "light": "#EADDDD", "highContrast": "#5B3F43", "highContrastLight": "#F0DADC" }
      },
      {
        "id": "git4vsc.blame.oldestBackground",
        "description": "Git blame annotation background for the oldest changes.",
        "defaults": { "dark": "#49464A", "light": "#E2DFE2", "highContrast": "#484248", "highContrastLight": "#E7E1E7" }
      }
    ]
  }
}
