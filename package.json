{
  "name": "git4vsc-workspace",
  "version": "0.1.6",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:extension": "pnpm --filter git4vsc test:extension",
    "package:vscode": "pnpm --filter git4vsc package:vsix",
    "lint": "eslint .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "globals": "^17.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.0"
  }
}
